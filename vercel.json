{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/rooms/(.*)",
      "destination": "/api/rooms"
    },
    {
      "source": "/api/rooms",
      "destination": "/api/rooms"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
